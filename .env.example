# Copy to .env. Everything is optional.
WEB_PORT=8080          # host port of the edge proxy
SITE_ADDRESS=:8080     # a real domain turns on automatic HTTPS (also publish 80/443 then)
API_TOKEN=             # server-to-server only: the API then demands "Authorization: Bearer <token>" and the bundled dashboard stops working
                       # (it is public and sends no token). Protect the dashboard with real authentication instead; see docs/runbook.md.
